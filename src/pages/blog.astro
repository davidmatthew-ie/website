---
import { getCollection } from 'astro:content';
import Page from '@layouts/Page.astro';
import Card from '@components/Card.astro';
const title = 'Blog Articles';
const description = 'Articles and tutorials covering web development, creative coding, Linux and music.';

// Filter drafts out of production and sort posts by date.
const posts = (await getCollection('posts'))
  .filter((post) => !import.meta.env.PROD || post.data.draft !== true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Colours to cycle through.
const colours = ['text-amber-400', 'text-lime-400', 'text-emerald-400', 'text-cyan-400'];
---

<Page title={ title } description={ description }>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-5 my-10">

    { posts.map((post, index) => 
      <Card
        colour={ colours[index % colours.length] }
        content={ post.data.description }
        date={ post.data.date }
        delay={ `${index}00ms` }
        tags={ post.data.tags }
        title={ post.data.title }
        url={ `/${post.id}/` }
      /> 
    )}

  </div>

</Page>
