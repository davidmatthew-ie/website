---
import { getCollection } from 'astro:content';
import Page from '@layouts/Page.astro';
import Card from '../../components/Card.astro';
import TagsIcon from '@icons/tags-duotone-rounded.svg';
import { slugify } from '../../js/utils.js';

export async function getStaticPaths() {
  const allPosts = (await getCollection('posts'))
    .filter((post) => !import.meta.env.PROD || post.data.draft !== true)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags.includes(tag)
    );
    tag = slugify(tag);
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const getOriginalTag = () => {
  const tags = [... new Set(posts.map(post => post.data.tags).flat())];
  return tags.filter(t => slugify(t) === tag);
}

const title = `Posts tagged "${ getOriginalTag() }"`;
const description = `Articles and tutorials covering "${ getOriginalTag() }"`;
const colours = ['text-amber-400', 'text-lime-400', 'text-emerald-400', 'text-cyan-400'];
---

<Page title={ title } description={ description }>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-5 my-10">

    { posts.map((post, index) => 
      <Card
        colour={ colours[index % colours.length] }
        content={ post.data.description }
        date={ post.data.date }
        delay={ `${index}00ms` }
        tags={ post.data.tags }
        title={ post.data.title }
        url={ `/${post.id}/` }
      /> 
    )}

  </div>

  <div class="flex items-center animate-fade-in-up">

    <span class="inline-block mr-2">

		  <TagsIcon class="w-6 min-w-6" />

	  </span>

    <a href="/tag/">See All Tags</a>

  </div>

</Page>

