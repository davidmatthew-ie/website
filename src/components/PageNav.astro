---
import PageNavLinks from './PageNavLinks.astro';
import CancelIcon from '@assets/icons/cancel-01-solid-rounded.svg';
import SidebarIcon from '@assets/icons/sidebar-right-duotone-rounded.svg';

const { headings } = Astro.props;
---

<div class="relative hidden overflow-hidden h-screen xl:flex items-center -mt-30 animate-fade-in-right">

  <nav class="fixed no-scrollbar max-w-[40ch] flex flex-col justify-center">

		<PageNavLinks headings={ headings }/>

	</nav>

</div>

<div id="page-nav" class="fixed top-0 right-0 w-3/4 px-6 h-screen z-30 bg-zinc-800/95 border-l-2 border-zinc-600 flex items-center justify-center transition duration-500 translate-x-full">

  <div id="nav-close" class="fixed top-8 right-5 flex cursor-pointer">

    <CancelIcon />

  </div>

  <nav class="flex-col justify-center">

		<PageNavLinks headings={ headings } />

	</nav>

</div>

<div id="nav-open" class="fixed bottom-4 right-5 flex justify-center items-center w-16 h-16 rounded-full bg-zinc-800/90 border-2 border-zinc-600 animate-fade-in-right cursor-pointer transition active:bg-zinc-700 xl:hidden">

  <SidebarIcon />

</div>

<script>
// Mobile page-nav is intially hidden.
let isNavOpen = false;

// Page nav elements.
const pageNavContainer = document.getElementById('page-nav');

// Functionality for the nav-open button.
const navOpen = document.getElementById('nav-open');
navOpen?.addEventListener('click', (event) => {
  event.stopPropagation();
  pageNavContainer?.classList.remove('translate-x-full');
  pageNavContainer?.classList.add('translate-x-0');

  isNavOpen = true;
});

// Functionality for the nav-close button.
const navClose = document.getElementById('nav-close');
navClose?.addEventListener('click', () => {
  pageNavContainer?.classList.remove('translate-x-0');
  pageNavContainer?.classList.add('translate-x-full');

  isNavOpen = false;
});

// Allow dismissing the page nav by clicking anywhere outside it.
document.addEventListener('click', () => {
  if (isNavOpen) navClose?.click();
});
</script>
