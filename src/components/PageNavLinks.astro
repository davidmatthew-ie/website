---
type Heading = {
	depth: number,
	slug: string,
	text: string
};

const { headings } = Astro.props as { headings: Heading[] };
---

{ headings && headings.length > 0 &&

  <h4 class="text-xl mt-0 mb-1">Contents</h4>

	<ul class="ml-1 my-0 px-0 list-none leading-none">

		{
			headings.map((heading) => {
				if (heading.depth < 4) {
					const headingLevelClasses = heading.depth === 2 ? 'pl-3' : 'pl-5 text-zinc-400';
					const listClasses = `text-lg my-0 pb-1 border-l-2 border-zinc-600 ${ headingLevelClasses }`;
					const linkClasses = 'no-underline font-normal text-inherit visited:text-inherit';

					return (
						<li class={ listClasses }>
							<a href={`#${heading.slug}`} class={ linkClasses }>
								{ heading.text }
							</a>
						</li>
					)
				}
			})
		}

	</ul>

}
